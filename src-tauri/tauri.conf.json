{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Animotion",
  "version": "0.1.0",
  "identifier": "com.animotion.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Animotion",
        "width": 1400,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "maximized": true,
        "center": true,
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Animotion",
    "shortDescription": "Animation dessin & pixel art",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "French"
        ],
        "installMode": "currentUser"
      }
    }
  }
}